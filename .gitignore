# Dependencias
node_modules/

# Bundle del frontend (Vite) — se compila, no se versiona
web/dist/

# Logs / runtime
*.log
.run/
.logs/

# Config local (raíz elegida por PC) — no se versiona
config.json

# Variables de entorno locales (rutas personales) — no se versiona
.env

# Biblioteca personal de estudio (skill `research-this`) — se lee con la app,
# pero es contenido del usuario, no del proyecto. Anclado con `/` para no
# matchear una futura carpeta `research` anidada en el código.
/research/

# Salida del instalador (electron-builder)
dist/

# Binarios de Piper (modo lector, voz neuronal) — se bajan con `npm run fetch:piper`
# (idempotente, corre como prebuild). ~90 MB: no se versionan, se empaquetan al buildear.
web/public/piper/

# Certificado de firma (privado y público generados) — NO versionar
build/cert/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# NOTA: public/vendor/ SÍ se versiona a propósito (libs vendoreadas para uso offline)
