{
  "name": "md-reader",
  "version": "2.4.0",
  "description": "Lector local de Markdown y mocks HTML: tablas, Mermaid, resaltado, TOC, edición y estilos personalizables. Funciona como app de Windows o vía CLI.",
  "license": "MIT",
  "author": "Joaquin Rodriguez",
  "type": "commonjs",
  "main": "electron/main.js",
  "bin": {
    "md-reader": "server.js"
  },
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,magenta \"node server.js --no-open\" \"vite\"",
    "dev:server": "node server.js --no-open",
    "dev:web": "vite",
    "fetch:piper": "node scripts/fetch-piper-assets.mjs",
    "prebuild": "node scripts/fetch-piper-assets.mjs",
    "build": "vite build",
    "start": "node server.js",
    "app": "electron .",
    "build:win": "npm run build && electron-builder --win"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "markdown",
    "viewer",
    "reader",
    "mermaid",
    "offline",
    "electron",
    "react"
  ],
  "build": {
    "appId": "com.joacorp.mdreader",
    "productName": "Markdown Reader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "electron/**",
      "web/dist/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Markdown Reader",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "dompurify": "^3.1.6",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.2",
    "mermaid": "^10.9.1",
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "zustand": "^5.0.1"
  }
}
